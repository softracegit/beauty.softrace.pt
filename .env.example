APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Opcional: conta com role super_admin (área /super-admin). Depois: php artisan db:seed --class=SuperAdminUserSeeder
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_PASSWORD=

APP_TIMEZONE=UTC

# Fuso só para o fluxo público /booking (horários mostrados ao cliente)
BOOKING_BUSINESS_TIMEZONE=Europe/Lisbon

# Link mágico /booking (minutos até expirar o token no email)
BOOKING_MAGIC_LINK_TTL_MINUTES=60

# Código OTP (login por email/SMS na marcação e verificação de contacto na conta)
BOOKING_AUTH_CODE_TTL_MINUTES=10
BOOKING_OTP_SEND_COOLDOWN_SECONDS=30
BOOKING_OTP_SEND_MAX_PER_WINDOW=6
BOOKING_OTP_SEND_COUNT_WINDOW_HOURS=1
BOOKING_OTP_SEND_LOCKOUT_HOURS=2
# Lembrete SMS de marcação (minutos antes da hora marcada)
BOOKING_SMS_REMINDER_LEAD_MINUTES=120
# Tolerância para atraso do scheduler (minutos)
BOOKING_SMS_REMINDER_GRACE_MINUTES=5

# Sessão web (minutos). Para clientes /booking ficarem autenticados muito tempo sem novo link,
# aumenta (ex.: 43200 = 30 dias). Aplica-se a todo o site (inclui backoffice).
# SESSION_LIFETIME=43200

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Fora de production, config/mail.php pode redireccionar todos os emails para MAIL_TEST_REDIRECT_TO.
# O mailer "booking" (magic link + notificação ao técnico na submissão em /booking) ignora esse redireccionamento.
# MAIL_TEST_REDIRECT_TO=suporte@exemplo.pt
# MAIL_TEST_REDIRECT_NAME="Suporte"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Stripe (Payment Intents — marcação online)
STRIPE_API_KEY=
STRIPE_API_SECRET=
# Opcional: copiar do Dashboard Stripe (ex.: 2024-11-20.acacia). Vazio = versão do SDK. Evita datas inventadas.
#STRIPE_API_VERSION=
# Webhook: stripe listen --forward-to http://localhost/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Métodos no checkout /booking: auto = tudo o elegível no Dashboard (MB WAY, Multibanco, etc.).
# Lista explícita = só esses. MB WAY na API Stripe: mb_way (aceita também mbway no .env).
STRIPE_BOOKING_PAYMENT_METHODS=auto

# Percentagem de depósito na marcação pública (resto na loja). Moeda: BOOKING_CURRENCY
BOOKING_DEPOSIT_PERCENT=20
BOOKING_CURRENCY=eur

# Twilio (SMS — Campanhas SMS no CRM)
# APP_ENV=local: usa chaves sandbox (fallback para as reais se vazio).
TWILIO_ACCOUNT_SID_SANDBOX=
TWILIO_AUTH_TOKEN_SANDBOX=
# Produção (ou fallback do local quando SANDBOX estiver vazio). Alternativas: TWILIO_SID / TWILIO_TOKEN
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sender ID alfanumérico (ex.: Fadastudio) ou número E.164 comprado na Twilio
TWILIO_SMS_FROM=

# VENDUS API
VENDUS_API_KEY=e1712a32e78bad519a986d5249713c08
VENDUS_BASE_URL=https://www.vendus.pt/ws/v1.1/
VENDUS_AUTH_MODE=basic
VENDUS_DOCUMENTS_ENDPOINT=/documents/
# FR = fatura-recibo (pagamento à emissão); FT = fatura sem liquidação imediata
VENDUS_DOCUMENT_TYPE=FR
VENDUS_TAX_ID=NOR
VENDUS_CATEGORY_ID=
VENDUS_CATEGORY_TITLE=Serviços
VENDUS_REGISTER_ID=
# Opcional: forçar ID do meio de pagamento. Se vazio, usa GET /documents/paymentmethods/ e o meio da venda (MB Way, Cartão, …).
VENDUS_PAYMENT_METHOD_ID=
VENDUS_MODE=tests
# true = nao envia para API real (util para desenvolvimento local)
VENDUS_SIMULATE=true